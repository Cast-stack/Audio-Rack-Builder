# Postgres. Supabase, Neon or local — anything Prisma can reach.
#
# Supabase: Project settings -> Database -> Connection string.
#   DATABASE_URL is the POOLED string (Transaction mode, port 6543). Prisma
#     needs pgbouncer=true on it, and connection_limit=1 on serverless.
#   DIRECT_URL is the DIRECT string (Session mode, port 5432). Only migrations
#     and `db push` use it; a pooler cannot take the advisory locks they need.
# Both carry the database password, so neither belongs in this file — put the
# real ones in .env.local, which is gitignored.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Required for the gear research pipeline and for "Not in the catalog? Add it"
# in the planner. Without it the app still runs; research routes return 503 and
# the catalog is read-only.
#
# DATABASE_URL is NOT required for /api/gear/request. With it, a requested
# device is filed as a revision for review; without it the device still comes
# back and lives in that one browser, marked unverified.
ANTHROPIC_API_KEY=""

# "Not in the catalog? Add it" in the planner is an OPERATOR tool: every use
# costs a model call plus web searches. It is off, and its endpoint answers
# 404, unless ARB_ENABLE_GEAR_REQUEST is "1".
#
# ARB_ADMIN_TOKEN, when set, is also required. Set it on any server other
# people can reach. Sign a browser in once by opening /planner?admin=<token>.
#
# ARB_ADMIN_TOKEN is also what unlocks the feedback queue at /admin/feedback.
# Sending feedback needs nothing — anyone using the planner can do it, and it
# only needs DATABASE_URL to have somewhere to land. Reading it needs this
# token, and without one set the queue answers 404 to everybody, including you.
ARB_ENABLE_GEAR_REQUEST=""
ARB_ADMIN_TOKEN=""


# Optional overrides
GEAR_RESEARCH_MODEL="claude-opus-5"
GEAR_PRICING_MODEL="claude-haiku-4-5"

# Shared secret for the cron routes (Vercel cron sends it as a bearer token).
CRON_SECRET=""
