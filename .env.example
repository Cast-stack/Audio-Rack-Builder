# Postgres. Neon, Supabase or local — anything Prisma can reach.
# For local development against SQLite instead, see prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/audio_rack_builder?schema=public"

# Required for the gear research pipeline and for "Not in the catalog? Add it"
# in the planner. Without it the app still runs; research routes return 503 and
# the catalog is read-only.
#
# DATABASE_URL is NOT required for /api/gear/request. With it, a requested
# device is filed as a revision for review; without it the device still comes
# back and lives in that one browser, marked unverified.
ANTHROPIC_API_KEY=""

# Optional overrides
GEAR_RESEARCH_MODEL="claude-sonnet-4-5"
GEAR_PRICING_MODEL="claude-haiku-4-5"

# Shared secret for the cron routes (Vercel cron sends it as a bearer token).
CRON_SECRET=""
